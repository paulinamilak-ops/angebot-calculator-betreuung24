# Skopiuj ten plik jako .env i wpisz wlasne wartosci.
# Plik .env nigdy nie trafia do repozytorium.

# Minimum 32 znaki. Wygeneruj: openssl rand -hex 32
API_KEY=zmien-mnie-minimum-32-znaki-1234567890
JWT_SECRET=zmien-mnie-minimum-32-znaki-0987654321

# Reset hasla przez e-mail jest wylaczony, gdy te pola sa puste.
SMTP_USER=
SMTP_PASS=

# Generator AI wymaga lokalnej instalacji Ollama. 1 = wylaczony.
AI_DISABLED=1
